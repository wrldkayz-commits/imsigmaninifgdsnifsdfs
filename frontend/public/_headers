# Cloudflare Pages caching rules.

# Build assets carry a content hash in their filename, so a changed file always
# has a new URL. They can be cached permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# config.json is the one file you edit by hand after uploading. It must never be
# cached, or pointing the app at a different backend would appear to do nothing.
/config.json
  Cache-Control: no-store, must-revalidate

# index.html references the hashed assets, so it has to be revalidated or the
# browser would keep loading an old build.
/index.html
  Cache-Control: no-cache
